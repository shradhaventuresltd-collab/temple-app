{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "temple-directory-india",
          "appId": "1:109314154382:android:d34e6caea62c14124ccedf",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "temple-directory-india",
          "appId": "1:109314154382:ios:262247718f97cde64ccedf",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "macos": {
        "default": {
          "projectId": "temple-directory-india",
          "appId": "1:109314154382:ios:262247718f97cde64ccedf",
          "uploadDebugSymbols": false,
          "fileOutput": "macos/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "temple-directory-india",
          "configurations": {
            "android": "1:109314154382:android:d34e6caea62c14124ccedf",
            "ios": "1:109314154382:ios:262247718f97cde64ccedf",
            "macos": "1:109314154382:ios:262247718f97cde64ccedf",
            "web": "1:109314154382:web:ad68bb3740d1c3e34ccedf",
            "windows": "1:109314154382:web:79d1bb6c89367fb94ccedf"
          }
        }
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "hosting",
    "cleanUrls": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600, must-revalidate"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          }
        ]
      }
    ]
  }
}
