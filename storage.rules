rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Public directory images: unauthenticated clients may read
    // `temples/{docId}/…`. Uploads, overwrites, and deletes require admin.
    match /temples/{templeId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
