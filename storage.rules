rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Public directory images: unauthenticated clients may read
    // `temples/{docId}/…`. A `_480_g` thumb and a `_1080_g` gallery copy live
    // in that same prefix, so each is as publicly readable as the original. Uploads, overwrites, and
    // deletes require admin.
    match /temples/{templeId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
