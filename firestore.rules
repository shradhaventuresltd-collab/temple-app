rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin = Firebase Auth ID token custom claim `admin: true`.
    // Grant with the Admin SDK (see scripts/grant_admin.js). Clients cannot
    // set this claim themselves.
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // Public directory: anyone may read temple documents.
    // Create / update / delete require a signed-in admin.
    match /temples/{templeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Deny all other collections by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
