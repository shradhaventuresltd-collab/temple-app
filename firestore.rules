rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: temples
    // Document ID: slug derived from temple name (e.g., "meenakshi-amman-temple")
    // Fields:
    //   - id: string (required) - document slug ID
    //   - name: string (required, max 200) - temple name
    //   - state: string (required, max 100) - Indian state
    //   - city: string (required, max 100) - city name
    //   - deity: string (required, max 100) - primary deity
    //   - imageUrl: string (required, max 2000) - primary image URL
    //   - description: string (required, max 10000) - temple description
    //   - story: string (required, max 20000) - temple story/legend
    //   - address: string (required, max 500) - physical address
    //   - timings: string (required, max 1000) - opening hours
    //   - specialities: list of strings (max 20 items, each max 200 chars)
    //   - images: list of strings (max 50 items, each max 2000 chars, URLs)
    //   - photos: optional list (max 12) of {url, credit, licence, order}
    //       url: string, max 2000
    //       licence: CC-BY | CC-BY-SA | CC0 | Own | Permission
    //       order: int (0 is the cover; clients write the list sorted)
    //       credit: string, max 200, required for CC-BY and CC-BY-SA
    //     imageUrl and images are mirrors of photos, written in the same
    //     admin payload. Existing docs are not backfilled.
    //   - latitude: number (required, -90 to 90)
    //   - longitude: number (required, -180 to 180)
    //   - createdAt: timestamp (optional, immutable after creation)
    //
    // Access: Public read (this is a public temple directory).
    //         Admin-only create/update/delete via custom claim `admin: true`.
    //
    // Queries used by the app:
    //   - collection('temples').get()
    //   - collection('temples').orderBy('name').snapshots()
    //
    // Note: The seed service uses set() with merge:true for idempotent
    // upserts, which triggers update rules for existing docs. Merge writes
    // may not include every field (e.g. images are omitted to preserve
    // admin uploads), so update validation only checks fields present in
    // the request.
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    function optionalStringLength(field, minLen, maxLen) {
      return !(field in request.resource.data) ||
        (request.resource.data[field] is string &&
         request.resource.data[field].size() >= minLen &&
         request.resource.data[field].size() <= maxLen);
    }

    function isValidList(list, maxSize) {
      return list is list && list.size() <= maxSize;
    }

    function optionalValidList(field, maxSize) {
      return !(field in request.resource.data) ||
        (request.resource.data[field] is list &&
         request.resource.data[field].size() <= maxSize);
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function isPhotoLicence(value) {
      return value in ['CC-BY', 'CC-BY-SA', 'CC0', 'Own', 'Permission'];
    }

    // credit is required (non-empty, max 200) for CC-BY and CC-BY-SA.
    // For CC0, Own, and Permission it may be omitted or a string of at most 200.
    function photoCreditOk(photo) {
      let required = photo.licence == 'CC-BY' || photo.licence == 'CC-BY-SA';
      let present = 'credit' in photo;
      return required
        ? present &&
          photo.credit is string &&
          photo.credit.size() > 0 &&
          photo.credit.size() <= 200
        : !present || (photo.credit is string && photo.credit.size() <= 200);
    }

    function isValidPhoto(photo) {
      return photo is map &&
        photo.keys().hasAll(['url', 'licence', 'order']) &&
        photo.keys().hasOnly(['url', 'credit', 'licence', 'order']) &&
        photo.url is string &&
        photo.url.size() <= 2000 &&
        isPhotoLicence(photo.licence) &&
        photo.order is int &&
        photoCreditOk(photo);
    }

    // Rules have no loops. Check each of the 12 possible slots.
    function validPhotos(photos) {
      return photos is list &&
        photos.size() <= 12 &&
        (photos.size() < 1 || isValidPhoto(photos[0])) &&
        (photos.size() < 2 || isValidPhoto(photos[1])) &&
        (photos.size() < 3 || isValidPhoto(photos[2])) &&
        (photos.size() < 4 || isValidPhoto(photos[3])) &&
        (photos.size() < 5 || isValidPhoto(photos[4])) &&
        (photos.size() < 6 || isValidPhoto(photos[5])) &&
        (photos.size() < 7 || isValidPhoto(photos[6])) &&
        (photos.size() < 8 || isValidPhoto(photos[7])) &&
        (photos.size() < 9 || isValidPhoto(photos[8])) &&
        (photos.size() < 10 || isValidPhoto(photos[9])) &&
        (photos.size() < 11 || isValidPhoto(photos[10])) &&
        (photos.size() < 12 || isValidPhoto(photos[11]));
    }

    function optionalValidPhotos(data) {
      return !('photos' in data) || validPhotos(data.photos);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    // Strict validator for new documents — all required fields must exist.
    function isValidTempleCreate(data) {
      let requiredFields = [
        'id', 'name', 'state', 'city', 'deity', 'imageUrl',
        'description', 'story', 'address', 'timings',
        'specialities', 'images', 'latitude', 'longitude'
      ];
      let allowedFields = [
        'id', 'name', 'state', 'city', 'deity', 'imageUrl',
        'description', 'story', 'address', 'location', 'timings',
        'specialities', 'images', 'photos', 'latitude', 'longitude', 'createdAt'
      ];

      return hasRequiredFields(requiredFields) &&
        hasOnlyAllowedFields(allowedFields) &&
        validStringLength('id', 1, 200) &&
        validStringLength('name', 1, 200) &&
        validStringLength('state', 1, 100) &&
        validStringLength('city', 1, 100) &&
        validStringLength('deity', 1, 100) &&
        data.imageUrl is string && data.imageUrl.size() <= 2000 &&
        validStringLength('description', 1, 10000) &&
        validStringLength('story', 1, 20000) &&
        validStringLength('address', 1, 500) &&
        validStringLength('timings', 1, 1000) &&
        isValidList(data.specialities, 20) &&
        isValidList(data.images, 50) &&
        optionalValidPhotos(data) &&
        data.latitude is number &&
        data.latitude >= -90 && data.latitude <= 90 &&
        data.longitude is number &&
        data.longitude >= -180 && data.longitude <= 180;
    }

    // Relaxed validator for updates (including set-with-merge).
    // Does not require all fields — only validates fields that are present.
    // Prevents schema pollution via hasOnlyAllowedFields.
    function isValidTempleUpdate(data) {
      let allowedFields = [
        'id', 'name', 'state', 'city', 'deity', 'imageUrl',
        'description', 'story', 'address', 'location', 'timings',
        'specialities', 'images', 'photos', 'latitude', 'longitude', 'createdAt'
      ];

      return hasOnlyAllowedFields(allowedFields) &&
        optionalStringLength('id', 1, 200) &&
        optionalStringLength('name', 1, 200) &&
        optionalStringLength('state', 1, 100) &&
        optionalStringLength('city', 1, 100) &&
        optionalStringLength('deity', 1, 100) &&
        optionalStringLength('imageUrl', 0, 2000) &&
        optionalStringLength('description', 1, 10000) &&
        optionalStringLength('story', 1, 20000) &&
        optionalStringLength('address', 1, 500) &&
        optionalStringLength('timings', 1, 1000) &&
        optionalValidList('specialities', 20) &&
        optionalValidList('images', 50) &&
        optionalValidPhotos(data) &&
        (!('latitude' in data) || (data.latitude is number && data.latitude >= -90 && data.latitude <= 90)) &&
        (!('longitude' in data) || (data.longitude is number && data.longitude >= -180 && data.longitude <= 180));
    }

    // ===============================================================
    // Rules: temples collection
    // ===============================================================

    match /temples/{templeId} {
      // Public directory: anyone may read temple documents (no auth required).
      allow read: if true;

      // Only admins may create temples, with strict data validation.
      allow create: if isAdmin() && isValidTempleCreate(request.resource.data);

      // Only admins may update temples, with relaxed validation for merge writes.
      // createdAt is immutable once set.
      allow update: if isAdmin() &&
        isValidTempleUpdate(request.resource.data) &&
        areImmutableFieldsUnchanged(['createdAt']);

      // Only admins may delete temples.
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Default deny: all other collections
    // ===============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
